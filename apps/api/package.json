{
  "name": "@chronokid/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "test": "vitest run",
    "test:prepare-db": "tsx --conditions=source scripts/prepare-test-db.ts"
  },
  "dependencies": {
    "@chronokid/shared": "*",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.0",
    "dotenv": "^18.0.6",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.2.1",
    "postgres": "^3.4.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
