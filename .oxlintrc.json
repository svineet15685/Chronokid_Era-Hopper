{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "apps/api/drizzle/**",
    "**/playwright-report/**",
    "**/test-results/**"
  ],
  "rules": {
    "no-underscore-dangle": [
      "error",
      {
        "allow": [
          "__chronokid"
        ]
      }
    ],
    "import/no-unassigned-import": [
      "error",
      {
        "allow": [
          "**/*.css"
        ]
      }
    ],
    "unicorn/no-array-sort": "off"
  }
}
