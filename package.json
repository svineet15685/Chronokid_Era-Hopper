{
  "name": "chronokid-era-hopper",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm run dev --workspace=@chronokid/web\" \"npm run dev --workspace=@chronokid/api\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:local:start": "node scripts/local-db.mjs start",
    "db:local:stop": "node scripts/local-db.mjs stop",
    "db:local:status": "node scripts/local-db.mjs status",
    "db:generate": "npm run db:generate --workspace=@chronokid/api",
    "db:migrate": "npm run db:migrate --workspace=@chronokid/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.11"
  }
}